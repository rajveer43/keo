    given-names: "Rajveer"
doi: "10.5281/zenodo.24273473"
repository-code: "https://github.com/rajveer43/keo"
url: "https://pypi.org/project/keo/"
license: MIT
keywords:
  - clustering
  - k-means
  - e-means
  - o-means
  - benchmark
  - machine learning
  - Faiss
